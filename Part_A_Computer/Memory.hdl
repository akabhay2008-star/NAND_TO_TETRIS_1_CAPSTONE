// Abhay Kumar - Roll No. 2501730185
// Memory.hdl - RAM16K (0-16383), Screen (16384-24575), Keyboard (24576)
// address[14..13]: 00,01 -> RAM   10 -> Screen   11 -> Keyboard

CHIP Memory {
    IN  in[16], load, address[15];
    OUT out[16];

    PARTS:
    Not(in=address[14], out=isRam);
    Not(in=address[13], out=not13);
    And(a=address[14], b=not13, out=isScreen);

    And(a=load, b=isRam,    out=loadRam);
    And(a=load, b=isScreen, out=loadScreen);

    RAM16K(in=in, load=loadRam,    address=address[0..13], out=ramOut);
    Screen(in=in, load=loadScreen, address=address[0..12], out=screenOut);
    Keyboard(out=kbdOut);

    Mux4Way16(a=ramOut, b=ramOut, c=screenOut, d=kbdOut,
              sel=address[13..14], out=out);
}
